{
  "expo": {
    "name": "Click Health Pro",
    "slug": "click-health-pro",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/chp-logo.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.digimaveric.clickhealthpro"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/chp-icon.png",
        "backgroundImage": "./assets/chp-icon.png",
        "monochromeImage": "./assets/chp-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA",
        "RECORD_AUDIO"
      ],
      "package": "com.digimaveric.clickhealthpro",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyCdKxLk6V7LjdeKAzRr06obwzcnxVXlWfE"
        }
      }
    },
    "web": {
      "favicon": "./assets/chp-icon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow $(PRODUCT_NAME) to access your location for attendance and map features."
        }
      ],
      "expo-font",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos and videos for medical record attachments.",
          "cameraPermission": "Allow $(PRODUCT_NAME) to use your camera to capture medical record photos and videos.",
          "microphonePermission": "Allow $(PRODUCT_NAME) to use your microphone while recording medical record videos."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow $(PRODUCT_NAME) to use the microphone for voice dictation.",
          "speechRecognitionPermission": "Allow $(PRODUCT_NAME) to convert speech to text in your notes and forms.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox",
            "com.google.android.tts"
          ]
        }
      ]
    ],
    "extra": {}
  }
}
