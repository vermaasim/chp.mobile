{
  "expo": {
    "name": "Click Health Pro",
    "slug": "click-health-pro",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.digimaveric.clickhealthpro"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "package": "com.digimaveric.clickhealthpro",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyCdKxLk6V7LjdeKAzRr06obwzcnxVXlWfE"
        }
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow $(PRODUCT_NAME) to access your location for attendance and map features."
        }
      ],
      "expo-font",
      "@react-native-community/datetimepicker"
    ],
    "extra": {}
  }
}
